{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "brand": {
    "name": "TEDxLe Quy Don HS Binh Dinh",
    "theme": "Mã",
    "url": "https://tedxlequydon.org"
  },
  "color": {
    "bg":           { "$value": "#141414", "$type": "color", "$description": "Page background" },
    "surface":      { "$value": "#1c1d1d", "$type": "color", "$description": "Cards, panels" },
    "border":       { "$value": "#272828", "$type": "color", "$description": "Default border" },
    "border-light": { "$value": "#333434", "$type": "color", "$description": "Subtle dividers" },
    "red":          { "$value": "#eb0028", "$type": "color", "$description": "Primary accent — TED red" },
    "red-dim":      { "$value": "rgba(230,43,30,0.15)", "$type": "color", "$description": "Red tint for backgrounds" },
    "text":         { "$value": "#f0ede8", "$type": "color", "$description": "Primary text — warm off-white" },
    "text-dim":     { "$value": "#a8a8a8", "$type": "color", "$description": "Secondary text" },
    "text-muted":   { "$value": "#b8ab96", "$type": "color", "$description": "Captions, labels" }
  },
  "typography": {
    "font-display": { "$value": "'Fraunces', serif",        "$type": "fontFamily" },
    "font-serif":   { "$value": "'Playfair Display', serif", "$type": "fontFamily" },
    "font-body":    { "$value": "'Be Vietnam Pro', sans-serif", "$type": "fontFamily" },
    "size-hero":    { "$value": "clamp(88px, 20vw, 240px)", "$type": "fontSize" },
    "size-section": { "$value": "clamp(40px, 6vw, 80px)",  "$type": "fontSize" },
    "size-body":    { "$value": "clamp(0.88rem, 1.2vw, 1.05rem)", "$type": "fontSize" },
    "size-label":   { "$value": "0.6rem",                  "$type": "fontSize" },
    "leading-tight":{ "$value": "1.0",                     "$type": "lineHeight" },
    "leading-body": { "$value": "1.6",                     "$type": "lineHeight" },
    "leading-loose":{ "$value": "1.85",                    "$type": "lineHeight" }
  },
  "spacing": {
    "nav-h":     { "$value": "60px",   "$type": "dimension" },
    "max-w":     { "$value": "1280px", "$type": "dimension" },
    "section-py":{ "$value": "clamp(88px, 11vw, 160px)", "$type": "dimension" }
  },
  "motion": {
    "ease-out":    { "$value": "cubic-bezier(.165,.84,.44,1)",       "$type": "cubicBezier" },
    "ease-in-out": { "$value": "cubic-bezier(.455,.03,.515,.955)",   "$type": "cubicBezier" },
    "duration-fast":   { "$value": "160ms", "$type": "duration" },
    "duration-base":   { "$value": "240ms", "$type": "duration" },
    "duration-reveal": { "$value": "900ms", "$type": "duration" }
  }
}
